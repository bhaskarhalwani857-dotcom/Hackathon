# ========================================================
# BLACK ICE — AI Agent Security Firewall Environment Config
# ========================================================

# Application Metadata
PROJECT_NAME="BLACK ICE"
VERSION="1.0.0"
ENVIRONMENT="production"  # 'production' or 'development'
API_V1_STR="/api"

# JWT Security Secrets (CRITICAL: Generate a cryptographically strong 64-char key in production)
# Example generation: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY="generate-a-secure-random-secret-key-for-production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration (Supabase PostgreSQL / Cloud Postgres)
# Format: postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-SUPABASE-PROJECT-REF].supabase.co:5432/postgres
# For Supabase connection pooler (IPv4 compatible):
# DATABASE_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres"
# Local development fallback:
DATABASE_URL="postgresql://postgres:password@localhost:5432/blackice_db"

# Allowed CORS Origins (Comma-separated origins permitted to reach the API)
# In production, include your Vercel deployment domain:
CORS_ORIGINS="https://blackice.vercel.app,https://blackice-git-main-*.vercel.app,http://localhost:5173"

# Optional Cloud Neural Guardrail API Keys
# When provided, Black Ice enhances local heuristic & semantic classifiers with live model verification
GEMINI_API_KEY=""
OPENAI_API_KEY=""

# --------------------------------------------------------
# Frontend Environment Variable (Set in Vercel Dashboard)
# --------------------------------------------------------
# Points to your live Render backend URL:
# VITE_API_BASE_URL="https://blackice-firewall-api.onrender.com/api"
